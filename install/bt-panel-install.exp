#!/usr/bin/expect -f
# ============================================================
# 栖云台 · 宝塔面板 —— 官方安装器驱动（逐提示判断）
# 作者：茉莉  QQ:1265274322  官方Q群:570387739
# ============================================================
# 为什么要这个东西：
#
# 原来的写法是 `printf "y\nyes\nyes\n" | bash install_panel.sh`，把「答案顺序」
# 和「官方提问顺序」绑死了。实测官方 install_panel.sh（2026-09-21 版，
# sha256 95ed59e4…）里有三个提问点：
#
#     2427  Do you want to install Bt-Panel to the /www directory now?(y/n):
#     2445  输入yes开始安装:
#     824   输入yes强制安装:          <- 在函数里，是条件路径
#
# 文本顺序不等于运行顺序，官方插一个提问、或者改一下调用顺序，答案就会喂到
# 错的提示上。而且实测 bash 的 `read -p` 在 stdin 不是终端时**根本不打印提示**
# （管道/FIFO 都实测过，stderr 为空），所以喂管道时连"答错了"都看不出来。
#
# 这里用 expect 分配一个 pty，于是：
#   1) 提示会真的打印出来（pty 下 read -p 才输出）
#   2) 按**提示内容**决定答 y 还是 yes，与提问顺序无关
#   3) 出现不认识的提示 -> 卡住 -> 「静默 45 秒 + 停在冒号上」两关都过 -> 失败退出
#      （故意不在"看到冒号结尾"时就猜：见下面 timeout 分支里的说明）
#
# 用法：
#   /usr/bin/expect -f bt-panel-install.exp /root/install_panel.sh
# 退出码：
#   0  安装器正常结束
#   3  保留（当前逻辑不再主动返回，见下面的说明）
#   4  长时间无已知提示、无输出 —— 疑似卡在不认识的提问上
# ============================================================

set timeout 45
set installer [lindex $argv 0]
if {$installer eq ""} { set installer "/root/install_panel.sh" }
set transcript "/tmp/qyt_panel_install.log"

# 安装器会在 cwd 下生成临时文件，官方用法也是在 /root 下跑
cd /root

log_file $transcript
log_user 1

puts "\[驱动\] 安装器      : $installer"
puts "\[驱动\] 完整记录    : $transcript"
puts "\[驱动\] 应答方式    : 按提示内容判断（不依赖提问顺序）"
puts ""

set stalls 0
spawn /bin/bash $installer

expect {
    # ---- 已知提问 1：安装路径确认，答 y ----
    -re {\(y/n\)[^\r\n]{0,60}:\s*$} {
        puts "\n\[驱动\] 识别到 (y/n) 提问 -> 答 y"
        send "y\r"
        exp_continue
    }

    # ---- 已知提问 2/3：输入 yes 开始安装 / 强制安装，答 yes ----
    -re {输入yes[^\r\n]{0,60}:\s*$} {
        puts "\n\[驱动\] 识别到「输入yes」提问 -> 答 yes"
        send "yes\r"
        exp_continue
    }

    # ---- 静默超时：可能正卡在一个我们不认识的提问上 ----
    #
    # 为什么不用「短行 + 冒号结尾」去猜未识别的提问（上一版就是这么写的，实测误判）：
    # expect 的 `$` 匹配的是**缓冲区末尾**，不是行尾。而 bash 的 read -p 提示是不带
    # 换行的，所以「一个完整的提示」和「半个正在到达的行」在缓冲区里长得一模一样。
    # 实测撞上的是安装器的第一行输出：
    #     cat: /etc/hostname: No such file or directory
    # 它被分块投递，缓冲区恰好停在 "cat: "，于是被当成提示，直接误判失败。
    #
    # 现在改成：只认已知提示；其余情况靠"长时间完全没输出"来判定卡住。
    # 判定卡住时把日志尾部打出来，人工一眼就能看到它停在哪个提问上。
    timeout {
        # 两级判定：光"静默"或光"冒号结尾"都不够，两个同时成立才算卡住。
        #   - 半个正在到达的行：毫秒内就有后续输出，"静默"这一关会把它筛掉
        #   - 安静干活（解压 / 安装）：没有冒号结尾，"末行形状"这一关会把它筛掉
        incr stalls
        # 注意：不能读 $expect_out(buffer) —— expect 只在**匹配成功**后才设置 expect_out，
        # 超时的时候它根本不存在，会直接报 can't read "expect_out(buffer)"（实测踩到）。
        # 所以改成从 log_file 记的日志里取尾部。
        set tail ""
        if {[file exists $transcript]} {
            set f [open $transcript r]
            set data [read $f]
            close $f
            set tail [string range $data end-400 end]
        }
        if {[regexp {[^\r\n]{1,200}[：:][ \t]*$} $tail]} {
            puts "\n\[驱动\]\[失败\] 已经 $timeout 秒没有新输出，而最后停在冒号上 ——"
            puts "        安装器很可能正卡在一个我们不认识的提问上。最后一行："
            puts "          | [string range $tail end-160 end]"
            puts ""
            puts "        为什么不能自动猜：bash 的 read -p 提示不带换行，"
            puts "        expect 的 \$ 匹配的是缓冲区末尾而不是行尾，"
            puts "        「完整提示」和「半个到达中的行」在缓冲区里长得一样。"
            puts "        怎么处理：人工跑一次  bash $installer  看它问什么，"
            puts "        再把该答什么加进本文件的 expect 分支，然后重跑安装。"
            puts "        完整记录见 $transcript"
            exit 3
        }
        # 只是安静干活。累计静默超过 30 分钟就兜底失败。
        if {$stalls * $timeout > 1800} {
            puts "\n\[驱动\]\[失败\] 累计静默超过 30 分钟，安装器疑似卡死。"
            puts "        完整记录见 $transcript"
            exit 4
        }
        exp_continue
    }

    eof { }
}

catch wait result
set rc [lindex $result 3]
puts ""
puts "\[驱动\] 安装器退出码: $rc"
puts "\[驱动\] 完整记录    : $transcript"
exit $rc
