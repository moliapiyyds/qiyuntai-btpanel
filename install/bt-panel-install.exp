#!/usr/bin/expect -f
# ============================================================
# 栖云台 · 宝塔面板 —— 官方安装器驱动（逐提示判断）
# 作者：茉莉  QQ:1265274322  官方Q群:570387739
# ============================================================
# 为什么要这个东西：
#
# 原来的写法是 `printf "y\nyes\nyes\n" | bash install_panel.sh`，把「答案顺序」
# 和「官方提问顺序」绑死了。实测官方 install_panel.sh（2026-09-21 版，
# sha256 95ed59e4…）里有三个提问点：
#
#     2427  Do you want to install Bt-Panel to the /www directory now?(y/n):
#     2445  输入yes开始安装:
#     824   输入yes强制安装:          <- 在函数里，是条件路径
#
# 文本顺序不等于运行顺序，官方插一个提问、或者改一下调用顺序，答案就会喂到
# 错的提示上。而且实测 bash 的 `read -p` 在 stdin 不是终端时**根本不打印提示**
# （管道/FIFO 都实测过，stderr 为空），所以喂管道时连"答错了"都看不出来。
#
# 这里用 expect 分配一个 pty，于是：
#   1) 提示会真的打印出来（pty 下 read -p 才输出）
#   2) 按**提示内容**决定答 y 还是 yes，与提问顺序无关
#   3) 出现不认识的提示 -> 立刻失败退出，而不是乱答一个
#      （这是故意的：宁可停下来让人看一眼，也不要把答案喂到错的提示上）
#
# 用法：
#   /usr/bin/expect -f bt-panel-install.exp /root/install_panel.sh
# 退出码：
#   0  安装器正常结束
#   3  遇到无法识别的提问（拒绝盲目作答）
#   4  长时间无输出，疑似卡死
# ============================================================

set timeout 1800
set installer [lindex $argv 0]
if {$installer eq ""} { set installer "/root/install_panel.sh" }
set transcript "/tmp/qyt_panel_install.log"

# 安装器会在 cwd 下生成临时文件，官方用法也是在 /root 下跑
cd /root

log_file $transcript
log_user 1

puts "\[驱动\] 安装器      : $installer"
puts "\[驱动\] 完整记录    : $transcript"
puts "\[驱动\] 应答方式    : 按提示内容判断（不依赖提问顺序）"
puts ""

spawn /bin/bash $installer

expect {
    # ---- 已知提问 1：安装路径确认，答 y ----
    -re {\(y/n\)[^\r\n]{0,60}:\s*$} {
        puts "\n\[驱动\] 识别到 (y/n) 提问 -> 答 y"
        send "y\r"
        exp_continue
    }

    # ---- 已知提问 2/3：输入 yes 开始安装 / 强制安装，答 yes ----
    -re {输入yes[^\r\n]{0,60}:\s*$} {
        puts "\n\[驱动\] 识别到「输入yes」提问 -> 答 yes"
        send "yes\r"
        exp_continue
    }

    # ---- 不认识的提问：短行 + 以冒号结尾，像是提示符 ----
    -re {[^\r\n]{1,80}[：:]\s*$} {
        set bad $expect_out(0,string)
        puts "\n\[驱动\]\[失败\] 遇到无法识别的提问，拒绝盲目作答："
        puts "        > $bad"
        puts ""
        puts "        怎么处理："
        puts "          1) 人工跑一次  bash $installer  看它到底问什么"
        puts "          2) 把这个提示该答什么，加进本文件的 expect 分支"
        puts "          3) 核验后重跑安装"
        puts "        完整记录见 $transcript"
        exit 3
    }

    timeout {
        puts "\n\[驱动\]\[失败\] 超过 $timeout 秒没有任何输出，安装器疑似卡住。"
        puts "        完整记录见 $transcript"
        exit 4
    }

    eof { }
}

catch wait result
set rc [lindex $result 3]
puts ""
puts "\[驱动\] 安装器退出码: $rc"
puts "\[驱动\] 完整记录    : $transcript"
exit $rc
